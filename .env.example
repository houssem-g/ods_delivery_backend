# Copy to .env for a local run. Placeholders only: never commit real values.
# local | test | staging | production
ENVIRONMENT=local
LOG_LEVEL=INFO
# text (humans) | json (one object per line, for Loki / the cloud)
LOG_FORMAT=text
# build identifier (image tag or git sha), reported to Sentry; empty locally
APP_RELEASE=

# --- database ---------------------------------------------------------------
# used by docker compose for the db container
POSTGRES_PASSWORD=ods_delivery_local
DATABASE_URL=postgresql+asyncpg://ods_delivery:ods_delivery_local@localhost:5451/ods_delivery
# require on managed Postgres
DB_SSLMODE=disable
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
# connections the whole deployment may use
DB_MAX_CONNECTIONS=25
# kept free (migrations, psql, LISTEN, leader lock)
DB_CONNECTION_RESERVE=5
# uvicorn workers per pod
WEB_CONCURRENCY=1
DEPLOYMENT_REPLICAS=1
DB_NULLPOOL=false

# --- HTTP ---------------------------------------------------------------------
# 5190 = front dev server (npm run dev:ods), 5191 = front image (make up-full)
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190,http://localhost:5191,http://127.0.0.1:5191
# where Google sign-in sends the user back
PUBLIC_APP_URL=http://localhost:5190
API_PUBLIC_URL=http://localhost:8110

# --- auth ---------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=odsd_refresh
REFRESH_COOKIE_PATH=/api/auth
# true behind HTTPS (required outside local)
COOKIE_SECURE=false
COOKIE_DOMAIN=
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_SECONDS=60
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12
# empty = Google sign-in answers 503
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8110/api/auth/google/callback

# --- rate limiting --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_AUTH_EMAIL=6/minute
# getOfferRank calls per courier (the price sheet, while he edits, and his offers list)
RATE_LIMIT_OFFER_RANK=60/minute
# getNetworkPulse: anonymous callers per IP (Welcome screen), signed-in callers per user
RATE_LIMIT_PULSE_ANONYMOUS=30/minute
RATE_LIMIT_PULSE=60/minute
# getDemandPulse calls per courier
RATE_LIMIT_DEMAND_PULSE=30/minute

# --- e-mail ---------------------------------------------------------------------
# smtp | log
EMAIL_PROVIDER=smtp
EMAIL_FROM=ODS Delivery <no-reply@ods.local>
SMTP_HOST=localhost
# Mailpit locally (UI on http://localhost:8125)
SMTP_PORT=1125
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
SMTP_TIMEOUT_SECONDS=10

# --- object storage (MinIO locally, DO Spaces in the cloud) ----------------------
S3_ENDPOINT_URL=http://localhost:9110
S3_PUBLIC_ENDPOINT_URL=http://localhost:9110
# optional override for public/ objects (CDN)
S3_PUBLIC_BASE_URL=
# Canned ACL for public/ objects: empty with MinIO (bucket policy), public-read on DO Spaces
S3_PUBLIC_OBJECT_ACL=
S3_REGION=us-east-1
S3_ACCESS_KEY=odsdlv-local
S3_SECRET_KEY=odsdlv-local-secret
S3_BUCKET=ods-delivery
S3_TIMEOUT_SECONDS=15
UPLOAD_MAX_BYTES=10485760
SIGNED_URL_DEFAULT_SECONDS=300
SIGNED_URL_MAX_SECONDS=3600

# --- push -------------------------------------------------------------------------
# auto (fcm when credentials exist, else log) | fcm | log
PUSH_PROVIDER=auto
# path to a service-account JSON, outside the repo
FIREBASE_CREDENTIALS_PATH=
PUSH_TIMEOUT_SECONDS=10

# --- WhatsApp (Meta Cloud API) / SMS (WinSMS): OFF while the secrets are empty -------
# permanent system-user token
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# webhook signature (X-Hub-Signature-256); empty = webhook POSTs refused
WHATSAPP_APP_SECRET=
# webhook GET challenge; empty = verification refused
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_BASE=https://graph.facebook.com
WHATSAPP_API_VERSION=v21.0
# when the user has no language
WHATSAPP_TEMPLATE_LANG=fr
# critical alert not delivered in time -> SMS
WHATSAPP_FALLBACK_SECONDS=60
# template name overrides (defaults: ods_livreur_injoignable,
WHATSAPP_TPL_NO_RESPONSE=
# ods_livreur_en_route, ods_nouvelle_offre, ods_code_verification)
WHATSAPP_TPL_ON_THE_WAY=
WHATSAPP_TPL_NEW_OFFER=
WHATSAPP_TPL_VERIFICATION=
WINSMS_API_KEY=
# the validated sender name (e.g. ODS)
WINSMS_SENDER=
WINSMS_API_URL=https://www.winsmspro.com/sms/sms/api
# kill switch: true = nothing leaves
MESSAGING_DISABLED=false
MESSAGING_HTTP_TIMEOUT_SECONDS=8
MSG_LIMIT_PER_NUMBER_10MIN=4
MSG_LIMIT_PER_NUMBER_DAY=12
MSG_LIMIT_GLOBAL_MINUTE=30
MSG_LIMIT_GLOBAL_HOUR=400

# --- realtime / jobs ----------------------------------------------------------------
REALTIME_ENABLED=true
REALTIME_CHANNEL=delivery_events
SCHEDULER_ENABLED=true
SCHEDULER_LOCK_KEY=5318008110
SCHEDULER_LEADER_RETRY_SECONDS=30
# header x-cron-token for /api/admin/jobs/*/run and refreshOsmIndex
CRON_SECRET=

# --- observability ------------------------------------------------------------------
# GET /api/metrics (Prometheus): empty = endpoint answers 404; otherwise send it in X-Metrics-Token
METRICS_TOKEN=
# Sentry: empty = off; no PII is ever sent
SENTRY_DSN=
# defaults to ENVIRONMENT
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0

# --- maps (OpenStreetMap: Nominatim geocoding, Overpass import) ----------------------
# set a real contact (URL or e-mail) outside local
OSM_USER_AGENT="ODS-Delivery-API/0.1 (local development)"
# false = geocodeAddress answers from the places index only
NOMINATIM_ENABLED=true
NOMINATIM_URL=https://nominatim.openstreetmap.org
NOMINATIM_TIMEOUT_SECONDS=5
# public Nominatim policy: at most 1 request/s
NOMINATIM_MIN_INTERVAL_SECONDS=1
# longer queue = fall back to the places index
NOMINATIM_MAX_WAIT_SECONDS=2
# geocode_cache: Nominatim answers kept this long
GEOCODE_CACHE_DAYS=30
# ... and "not found" answers this long
GEOCODE_MISS_CACHE_HOURS=24
OVERPASS_URLS=https://overpass-api.de/api/interpreter,https://z.overpass-api.de/api/interpreter,https://overpass.kumi.systems/api/interpreter
OVERPASS_TIMEOUT_SECONDS=90
# multiplies the pauses between Overpass calls
OVERPASS_DELAY_SCALE=1
# daily 03:00 job refreshing one category of places
OSM_REFRESH_ENABLED=false

# --- orders ---------------------------------------------------------------------------
# see QA orders in the open list
QA_ACCOUNTS=lemelec346@sixoplus.com,vovine2891@sepole.com,test.admin@ods.tn
# getOrderETA routing; empty = straight-line estimate only
OSRM_URL=https://router.project-osrm.org
OSRM_TIMEOUT_SECONDS=4

# --- seed script only (scripts/seed_local.py) ----------------------------------------
LOCAL_ADMIN_EMAIL=admin@ods.local
# empty = admin created without password (account-setup flow)
LOCAL_ADMIN_PASSWORD=
QA_CONSTANTS_PATH=../ods-delivery/tests/helpers/constants.ts
