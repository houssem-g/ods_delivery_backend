# Copy to .env for a local run. Placeholders only: never commit real values.
ENVIRONMENT=local                     # local | test | staging | production
LOG_LEVEL=INFO

# --- database ---------------------------------------------------------------
POSTGRES_PASSWORD=ods_delivery_local  # used by docker compose for the db container
DATABASE_URL=postgresql+asyncpg://ods_delivery:ods_delivery_local@localhost:5451/ods_delivery
DB_SSLMODE=disable                    # require on managed Postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_MAX_CONNECTIONS=25                 # connections the whole deployment may use
DB_CONNECTION_RESERVE=5               # kept free (migrations, psql, LISTEN, leader lock)
WEB_CONCURRENCY=1                     # uvicorn workers per pod
DEPLOYMENT_REPLICAS=1
DB_NULLPOOL=false

# --- HTTP ---------------------------------------------------------------------
CORS_ORIGINS=http://localhost:5190,http://127.0.0.1:5190
PUBLIC_APP_URL=http://localhost:5190  # where Google sign-in sends the user back
API_PUBLIC_URL=http://localhost:8110

# --- auth ---------------------------------------------------------------------
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=odsd_refresh
REFRESH_COOKIE_PATH=/api/auth
COOKIE_SECURE=false                   # true behind HTTPS (required outside local)
COOKIE_DOMAIN=
EMAIL_CODE_TTL_MINUTES=10
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_SECONDS=60
PASSWORD_MIN_LENGTH=8
BCRYPT_ROUNDS=12
GOOGLE_CLIENT_ID=                     # empty = Google sign-in answers 503
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8110/api/auth/google/callback

# --- rate limiting --------------------------------------------------------------
RATE_LIMIT_ENABLED=true
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_AUTH_EMAIL=6/minute

# --- e-mail ---------------------------------------------------------------------
EMAIL_PROVIDER=smtp                   # smtp | log
EMAIL_FROM=ODS Delivery <no-reply@ods.local>
SMTP_HOST=localhost
SMTP_PORT=1125                        # Mailpit locally (UI on http://localhost:8125)
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false
SMTP_TLS=false
SMTP_TIMEOUT_SECONDS=10

# --- object storage (MinIO locally, DO Spaces in the cloud) ----------------------
S3_ENDPOINT_URL=http://localhost:9110
S3_PUBLIC_ENDPOINT_URL=http://localhost:9110
S3_PUBLIC_BASE_URL=                   # optional override for public/ objects (CDN)
S3_REGION=us-east-1
S3_ACCESS_KEY=odsdlv-local
S3_SECRET_KEY=odsdlv-local-secret
S3_BUCKET=ods-delivery
S3_TIMEOUT_SECONDS=15
UPLOAD_MAX_BYTES=10485760
SIGNED_URL_DEFAULT_SECONDS=300
SIGNED_URL_MAX_SECONDS=3600

# --- push -------------------------------------------------------------------------
PUSH_PROVIDER=auto                    # auto (fcm when credentials exist, else log) | fcm | log
FIREBASE_CREDENTIALS_PATH=            # path to a service-account JSON, outside the repo
PUSH_TIMEOUT_SECONDS=10

# --- realtime / jobs ----------------------------------------------------------------
REALTIME_ENABLED=true
REALTIME_CHANNEL=delivery_events
SCHEDULER_ENABLED=true
SCHEDULER_LOCK_KEY=5318008110
SCHEDULER_LEADER_RETRY_SECONDS=30
CRON_SECRET=                          # header x-cron-token for /api/admin/jobs/*/run

# --- seed script only (scripts/seed_local.py) ----------------------------------------
LOCAL_ADMIN_EMAIL=admin@ods.local
LOCAL_ADMIN_PASSWORD=                 # empty = admin created without password (account-setup flow)
QA_CONSTANTS_PATH=../ods-delivery/tests/helpers/constants.ts
